{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intent sketch v1, proposal only",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "steps"],
  "properties": {
    "schema": {"const": "intent_sketch.v1"},
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["op", "polarity", "evidence"],
        "properties": {
          "op": {"enum": ["move", "stack", "unstack", "swap", "remember", "register", "arrange", "repeat", "stop_motion", "stop_repeat", "continue", "return", "status", "clarify", "question"]},
          "polarity": {"enum": ["request", "exclude", "query", "uncertain"]},
          "args": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "source_slot": {"type": "integer"},
              "destination_slot": {"type": "integer"},
              "object_id": {"type": "integer"},
              "count": {"type": "integer"},
              "height": {"type": "integer"},
              "layout": {
                "type": "array", "minItems": 1, "maxItems": 8,
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["slot"],
                  "properties": {
                    "slot": {"type": "integer"},
                    "count": {"type": "integer"},
                    "object_ids": {"type": "array", "maxItems": 8, "items": {"type": "integer"}}
                  }
                }
              },
              "repeat_mode": {"enum": ["continuous", "total", "additional", "unresolved"]},
              "repeat_count": {"type": "integer"},
              "boundary": {"enum": ["after_round", "after_task", "unresolved"]},
              "subject": {"enum": ["current_state", "active_task", "repeat", "unresolved"]},
              "reason": {"enum": ["ambiguous_reference", "missing_target", "negated_only", "question_only", "unsupported", "other"]},
              "question": {"type": "string", "maxLength": 300}
            }
          },
          "reference": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "mention"],
            "properties": {
              "kind": {"enum": ["active_task", "previous_task", "previous_program", "prior_steps", "arm_home", "registered_initial", "task_start", "learned_memory", "deictic", "unresolved"]},
              "mention": {"type": "string", "minLength": 1, "maxLength": 300},
              "step_indices": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "integer", "minimum": 0, "maximum": 15}}
            }
          },
          "exclusions": {
            "type": "array", "minItems": 1, "maxItems": 8,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["field", "value", "evidence"],
              "properties": {
                "field": {"enum": ["source_slot", "destination_slot", "object_id", "count", "height", "reference"]},
                "value": {"oneOf": [{"type": "integer"}, {"enum": ["active_task", "previous_task", "previous_program", "prior_steps", "arm_home", "registered_initial", "task_start", "learned_memory", "deictic", "unresolved"]}]},
                "evidence": {"type": "string", "minLength": 1, "maxLength": 300}
              }
            }
          },
          "evidence": {"type": "string", "minLength": 1, "maxLength": 300}
        }
      }
    }
  }
}
