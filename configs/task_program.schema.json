{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raccoon.local/schema/task-program-v1.json",
  "title": "Task program v1: structured proposal, not execution authorization",
  "description": "At most eight flat, ordered steps. Request ID is assigned by the caller. Repeat references prior steps without nesting. Unresolved references remain unresolved.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "steps"
  ],
  "properties": {
    "schema": {
      "const": "task_program.v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "kind",
              "source_slot",
              "destination_slot",
              "object_id",
              "count",
              "height",
              "layout",
              "evidence"
            ],
            "properties": {
              "op": {
                "const": "task"
              },
              "kind": {
                "enum": [
                  "move",
                  "stack",
                  "unstack",
                  "swap",
                  "remember",
                  "register",
                  "arrange"
                ]
              },
              "source_slot": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 4
              },
              "destination_slot": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 4
              },
              "object_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 4
              },
              "count": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 4
              },
              "height": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 2
              },
              "layout": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "slot",
                        "count",
                        "object_ids"
                      ],
                      "properties": {
                        "slot": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 4
                        },
                        "count": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 0,
                          "maximum": 2
                        },
                        "object_ids": {
                          "oneOf": [
                            {
                              "type": "null"
                            },
                            {
                              "type": "array",
                              "maxItems": 2,
                              "uniqueItems": true,
                              "items": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 4
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "target",
              "count",
              "evidence"
            ],
            "properties": {
              "op": {
                "const": "repeat"
              },
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "step_indices",
                  "reference"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "prior_steps",
                      "active_task",
                      "previous_task",
                      "previous_program",
                      "unresolved"
                    ]
                  },
                  "step_indices": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 4,
                        "uniqueItems": true,
                        "items": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 7
                        }
                      }
                    ]
                  },
                  "reference": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              },
              "count": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mode",
                  "value"
                ],
                "properties": {
                  "mode": {
                    "enum": [
                      "continuous",
                      "total",
                      "additional",
                      "unresolved"
                    ]
                  },
                  "value": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  }
                }
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "scope",
              "evidence"
            ],
            "properties": {
              "op": {
                "const": "stop_motion"
              },
              "scope": {
                "const": "active_task"
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "boundary",
              "evidence"
            ],
            "properties": {
              "op": {
                "const": "stop_repeat"
              },
              "boundary": {
                "enum": [
                  "after_round",
                  "after_task",
                  "unresolved"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "target",
              "evidence"
            ],
            "properties": {
              "op": {
                "const": "return"
              },
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "reference"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "arm_home",
                      "registered_initial",
                      "task_start",
                      "learned_memory",
                      "unresolved"
                    ]
                  },
                  "reference": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "reason",
              "question",
              "evidence"
            ],
            "properties": {
              "op": {
                "const": "clarify"
              },
              "reason": {
                "enum": [
                  "ambiguous_reference",
                  "missing_target",
                  "negated_only",
                  "question_only",
                  "unsupported",
                  "other"
                ]
              },
              "question": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 300
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "subject",
              "evidence"
            ],
            "properties": {
              "op": {
                "const": "status"
              },
              "subject": {
                "enum": [
                  "current_state",
                  "active_task",
                  "repeat",
                  "unresolved"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "target",
              "evidence"
            ],
            "properties": {
              "op": {
                "const": "continue"
              },
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "reference"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "active_task",
                      "unresolved"
                    ]
                  },
                  "reference": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        ]
      }
    }
  }
}
